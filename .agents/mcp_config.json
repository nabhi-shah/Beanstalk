{
  "mcpServers": {
    "xcode": {
      "command": "xcrun",
      "args": ["mcpbridge"]
    },
    "figma": {
      "command": "npx",
      "args": ["-y", "figma-mcp"],
      "env": {
        "FIGMA_ACCESS_TOKEN": "<YOUR_FIGMA_TOKEN_HERE>",
        "FIGMA_PERSONAL_ACCESS_TOKEN": "<YOUR_FIGMA_TOKEN_HERE>",
        "FIGMA_API_KEY": "<YOUR_FIGMA_TOKEN_HERE>"
      }
    }
  }
}
